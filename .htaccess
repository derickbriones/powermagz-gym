RewriteEngine On
# No RewriteBase: mod_rewrite derives it per-directory, so the same file works
# whether the app is served from a subfolder or from the domain root (Render).

# Never serve private folders or build/source files directly.
RewriteRule ^(config|src|storage|tests|database|vendor|scripts)(/|$) - [F,L]

Options -Indexes

<FilesMatch "(^\.env.*|^\.dockerignore$|^\.gitignore$|^Dockerfile$|^start\.sh$|^router\.php$|\.(sql|log|md|lock)$|^composer\.json$|^docker-compose\.yml$)">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
