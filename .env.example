# ============================================================================
#  PowerMagz Gym — Environment Configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env` to git.
#
#  Setup:
#    1. cp .env.example .env
#    2. php scripts/keygen.php       (generates APP_KEY)
#    3. Edit DB_* values below to match your environment
#    4. Verify:  php scripts/test_crypto.php
# ============================================================================

# ----------------------------------------------------------------------------
#  APPLICATION
# ----------------------------------------------------------------------------

APP_NAME="PowerMagz Gym"
APP_URL=http://localhost/powermagz-gym
APP_ENV=local
APP_TIMEZONE=Asia/Manila

# Generated by `php scripts/keygen.php`
# Format: base64:... (32 raw bytes, base64-encoded)
# ⚠️  CRITICAL: Back this up offline. Losing it makes encrypted data unreadable.
APP_KEY=


# ----------------------------------------------------------------------------
#  DATABASE  (MySQL 8+ / MariaDB 10.4+)
# ----------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=powermagz_gym
DB_USER=root
DB_PASS=

# Docker-compose overrides these — see docker-compose.yml


# ----------------------------------------------------------------------------
#  EMAIL  (spec §2.2 — transactional email)
# ----------------------------------------------------------------------------
# In `local` env, emails are logged to storage/logs/php-error.log instead of sent.
# For production, configure SMTP via PHPMailer or use a transactional provider
# (SendGrid / Mailgun / Postmark / AWS SES).

MAIL_FROM=no-reply@powermagz.ph
MAIL_DRIVER=log
# For SMTP, set MAIL_DRIVER=smtp and fill:
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_ENCRYPTION=tls


# ----------------------------------------------------------------------------
#  BACKUPS  (spec §2.2)
# ----------------------------------------------------------------------------

# Where local backups are written
BACKUP_DIR=

# Delete local backups older than N days (spec minimum retention: 365 for audit logs)
BACKUP_RETAIN_DAYS=30

# Encrypt dumps with AES-256-GCM using APP_KEY
BACKUP_ENCRYPT=true

# Explicit path to mysqldump (blank = PATH lookup)
BACKUP_MYSQLDUMP_BIN=

# Remote geo-redundant storage: none | s3 | gcs | b2 | custom
BACKUP_REMOTE=none


# ----------------------------------------------------------------------------
#  AWS S3  (only when BACKUP_REMOTE=s3)
# ----------------------------------------------------------------------------

# S3_BUCKET=powermagz-gym-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1


# ----------------------------------------------------------------------------
#  GOOGLE CLOUD STORAGE  (only when BACKUP_REMOTE=gcs)
# ----------------------------------------------------------------------------

# GCS_BUCKET=powermagz-gym-backups


# ----------------------------------------------------------------------------
#  BACKBLAZE B2  (only when BACKUP_REMOTE=b2)
# ----------------------------------------------------------------------------

# B2_BUCKET=powermagz-gym-backups
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=


# ----------------------------------------------------------------------------
#  PAYMENT PROVIDER  (spec §2.2 — PCI DSS compliance)
# ----------------------------------------------------------------------------
# The spec requires NO raw card storage. Use a tokenization provider.
#
# GCash: tokenize via PayMongo / Xendit / Dragonpay
# Cards: tokenize via Stripe / PayMongo
#
# The gym's actual GCash number is a constant in config/config.php.
# Tokenized payment methods are stored encrypted via crypto.php.

PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER=paymongo
# PAYMONGO_SECRET_KEY=sk_live_...
# PAYMONGO_PUBLIC_KEY=pk_live_...


# ----------------------------------------------------------------------------
#  SECURITY TUNING  (spec §2.1 + §2.2)
# ----------------------------------------------------------------------------

# Default idle session timeout in minutes (spec §2.1 minimum: 30)
SESSION_IDLE_MINUTES=30

# Whether to require HTTPS in production (checked by portal_foot.php)
FORCE_HTTPS=false

# Whether to log every write action to audit_logs (spec §2.1: always true in prod)
AUDIT_ENABLED=true


# ----------------------------------------------------------------------------
#  MFA  (spec §2.1)
# ----------------------------------------------------------------------------

# Application name shown in authenticator apps
MFA_ISSUER="PowerMagz Gym"

# Require admin accounts to enroll MFA (shows nudge banner if true)
MFA_REQUIRED_FOR_ADMIN=true